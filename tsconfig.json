{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@eink/core": ["packages/core/src/index.ts"],
      "@eink/core/*": ["packages/core/src/*"],
      "@eink/sokoban": ["packages/games/sokoban/src/index.ts"],
      "@eink/sokoban/*": ["packages/games/sokoban/src/*"],
      "@eink/klotski": ["packages/games/klotski/src/index.ts"],
      "@eink/klotski/*": ["packages/games/klotski/src/*"],
      "@eink/lightsout": ["packages/games/lightsout/src/index.ts"],
      "@eink/lightsout/*": ["packages/games/lightsout/src/*"],
      "@eink/memory": ["packages/games/memory/src/index.ts"],
      "@eink/memory/*": ["packages/games/memory/src/*"],
      "@eink/gomoku": ["packages/games/gomoku/src/index.ts"],
      "@eink/gomoku/*": ["packages/games/gomoku/src/*"],
      "@eink/fifteen": ["packages/games/fifteen/src/index.ts"],
      "@eink/fifteen/*": ["packages/games/fifteen/src/*"],
      "@eink/sudoku": ["packages/games/sudoku/src/index.ts"],
      "@eink/sudoku/*": ["packages/games/sudoku/src/*"],
      "@eink/minesweeper": ["packages/games/minesweeper/src/index.ts"],
      "@eink/minesweeper/*": ["packages/games/minesweeper/src/*"],
      "@eink/2048": ["packages/games/2048/src/index.ts"],
      "@eink/2048/*": ["packages/games/2048/src/*"],
      "@eink/snake": ["packages/games/snake/src/index.ts"],
      "@eink/snake/*": ["packages/games/snake/src/*"],
      "@eink/tetris": ["packages/games/tetris/src/index.ts"],
      "@eink/tetris/*": ["packages/games/tetris/src/*"],
      "@eink/match3": ["packages/games/match3/src/index.ts"],
      "@eink/match3/*": ["packages/games/match3/src/*"],
      "@eink/doudizhu": ["packages/games/doudizhu/src/index.ts"],
      "@eink/doudizhu/*": ["packages/games/doudizhu/src/*"],
      "@eink/ui": ["packages/ui/src/index.ts"],
      "@eink/ui/*": ["packages/ui/src/*"],
      "@eink/platform": ["packages/platform/src/index.ts"],
      "@eink/platform/*": ["packages/platform/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "packages/games/*/src/**/*",
    "packages/games/*/test/**/*",
    "packages/games/*/tools/**/*",
    "apps/web/src/**/*"
  ]
}
