{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@eink/core": ["packages/core/src/index.ts"],
      "@eink/core/*": ["packages/core/src/*"],
      "@eink/sokoban": ["packages/games/sokoban/src/index.ts"],
      "@eink/sokoban/*": ["packages/games/sokoban/src/*"],
      "@eink/reversi": ["packages/games/reversi/src/index.ts"],
      "@eink/reversi/*": ["packages/games/reversi/src/*"],
      "@eink/sudoku": ["packages/games/sudoku/src/index.ts"],
      "@eink/sudoku/*": ["packages/games/sudoku/src/*"],
      "@eink/minesweeper": ["packages/games/minesweeper/src/index.ts"],
      "@eink/minesweeper/*": ["packages/games/minesweeper/src/*"],
      "@eink/2048": ["packages/games/2048/src/index.ts"],
      "@eink/2048/*": ["packages/games/2048/src/*"],
      "@eink/ui": ["packages/ui/src/index.ts"],
      "@eink/ui/*": ["packages/ui/src/*"],
      "@eink/platform": ["packages/platform/src/index.ts"],
      "@eink/platform/*": ["packages/platform/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "packages/games/*/src/**/*",
    "packages/games/*/test/**/*",
    "packages/games/*/tools/**/*",
    "apps/web/src/**/*"
  ]
}
